  "explainers": [
    {
      "startSec": 22.855,
      "endSec": 27.455,
      "heading": "What is a TCAS RA?",
      "body": "TCAS is an onboard collision-avoidance system. A Resolution Advisory (RA) tells pilots to climb or descend to keep separation from nearby traffic, and they follow it promptly."
    },
    {
      "startSec": 66.46,
      "endSec": 71.06,
      "heading": "Autoland and critical areas",
      "body": "Autoland lets the aircraft land itself using ILS signals. Protected critical areas keep those signals clean; when not protected, crews know signals may be disturbed."
    }
  ],

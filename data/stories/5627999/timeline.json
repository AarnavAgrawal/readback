  "explainers": [
    {
      "startSec": 14.32,
      "endSec": 18.92,
      "heading": "What is a go-around?",
      "body": "A routine, trained maneuver: the pilot discontinues the landing, climbs away, and controllers guide the aircraft back around for another approach."
    },
    {
      "startSec": 23.561,
      "endSec": 28.161,
      "heading": "Wake turbulence",
      "body": "Wings leave swirling air behind them. A following aircraft that encounters it can be jolted or rolled, so pilots may abandon the approach and try again."
    }

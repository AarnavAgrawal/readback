# Copy to .env and fill in. Never commit .env.

# Enhanced Radar REST API key (dashboard → API keys).
ENHANCED_RADAR_API_KEY=

# Anthropic API key for the storyboard stage.
ANTHROPIC_API_KEY=

# Web app, optional locally (files fall back to ./.local-store without these).
# On Vercel they come from the Blob and Upstash integrations.
BLOB_READ_WRITE_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Spending limit: new searches and builds stop at this much total usage.
DEMO_TOTAL_CAP_USD=800
DEMO_STARTING_CREDIT_USD=1000
